{
  "name": "back-hub",
  "version": "0.0.1",
  "description": "Backend do hub",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:monolith": "rm -rf dist/monolith",
    "clean:identity": "rm -rf dist/identity",
    "build": "nx run-many --target=build --all",
    "build:monolith": "nx run monolith:build",
    "build:notification": "nx run notification:build",
    "build:identity": "nx run identity:build",
    "build:all": "nx run-many --target=build --all",
    "lint": "nx run-many --target=lint --all",
    "format": "nx format:write",
    "check:format": "nx format:check",
    "check:lint": "nx run-many --target=lint --all",
    "start": "nest start",
    "prestart:dev": "yarn format",
    "start:dev": "nest start --watch",
    "prestart:dev:notification": "yarn clean:notification && yarn format",
    "prestart:dev:identity": "yarn clean:identity && yarn format",
    "start:dev:notification": "nest start --watch notification",
    "start:dev:identity": "nest start --watch identity",
    "start:debug": "nest start --debug --watch",
    "start:debug:notification": "nest start notification --debug --watch --trace-warnings",
    "start:debug:identity": "nest start identity --debug --watch --trace-warnings",
    "start:prod": "node dist/src/main",
    "start:prod:notification": "node dist/notification/apps/notification/src/main.js",
    "start:prod:identity": "node dist/identity/apps/identity/src/main.js",
    "db:compile": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "db:generate": "yarn db:compile migration:generate -d src/common/typeorm/typeorm-datasource.ts",
    "db:generate:identity": "yarn db:compile migration:generate -d packages/identity/persistence/typeorm-datasource.ts",
    "db:migrate:identity": "yarn db:compile migration:run -d packages/identity/persistence/typeorm-datasource.ts",
    "db:migrate:test:identity": "NODE_ENV=test yarn db:compile migration:run -d packages/identity/persistence/typeorm-datasource.ts",
    "db:drop:identity": "yarn db:compile schema:drop -d packages/identity/persistence/typeorm-datasource.ts",
    "test": "nx run-many --target=test --all",
    "test:watch": "nx test --watch",
    "test:cov": "nx run-many --target=test --all --parallel=false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand --config=jest.config.js",
    "test:identity": "nx run identity:test",
    "test:notification": "nx run notification:test",
    "test:all": "nx run-many --target=test --all"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "^6.0.1",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.5",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@slack/webhook": "^7.0.5",
    "@types/handlebars": "^4.1.0",
    "argon2": "^0.43.0",
    "aws-sdk": "^2.1685.0",
    "cache-manager": "^6.4.3",
    "cache-manager-redis-yet": "^5.1.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "handlebars": "^4.7.8",
    "ms": "^2.1.3",
    "nestjs-cls": "^6.0.1",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-extension": "^3.5.0",
    "typeorm-transactional": "^0.5.0",
    "ulid": "^3.0.0",
    "uuid": "^13.0.0",
    "winston": "^3.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.0",
    "@nx/eslint": "22.0.3",
    "@nx/eslint-plugin": "22.0.3",
    "@nx/jest": "22.0.3",
    "@nx/js": "22.0.3",
    "@nx/nest": "22.0.3",
    "@nx/node": "22.0.3",
    "@nx/web": "22.0.3",
    "@nx/webpack": "22.0.3",
    "@types/amqplib": "^0.10.7",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^24.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "dotenv": "^17.1.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-project-structure": "^3.2.1",
    "factory.ts": "^1.4.2",
    "jest": "^29.5.0",
    "jest-mock": "^29.7.0",
    "lint-staged": "^16.0.0",
    "nx": "22.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0"
  },
  "nx": {},
  "workspaces": [
    "apps/*",
    "packages/notification",
    "packages/identity",
    "shared/lib",
    "shared/module"
  ]
}
